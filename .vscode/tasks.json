{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install deps",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "seed",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m scripts.seed",
      "problemMatcher": []
    },
    {
      "label": "serve",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/uvicorn api.main:app --reload --port 8000",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "demo pipeline",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m scripts.run_demo",
      "problemMatcher": []
    }
  ]
}
