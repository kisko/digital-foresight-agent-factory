# Copy to .env to enable real LLM calls. Without these, shared/llm.py runs
# in deterministic stub mode and the prototype works end-to-end without keys.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Path overrides (defaults are fine for local dev)
FORESIGHT_DATA_DIR=./data
FORESIGHT_DB_PATH=./data/foresight.db
